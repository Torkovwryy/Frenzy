{
  "name": "frenzy",
  "version": "0.0.0-development",
  "type": "module",
  "description": "A universal, secure, and blazing fast package manager.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "frenzy": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Tests will be configured next\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Torkovwryy/Frenzy.git"
  },
  "keywords": [
    "package-manager",
    "frenzy",
    "dependency-management",
    "node",
    "typescript",
    "security"
  ],
  "author": "Torkovwryy <krebinkkj3@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Torkovwryy/Frenzy/issues"
  },
  "homepage": "https://github.com/Torkovwryy/Frenzy#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@4.1.1",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
